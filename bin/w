#!/usr/bin/env python3

from __future__ import annotations

import os
import re
import subprocess
import sys
from functools import lru_cache
from typing import Optional


ROW_RE = re.compile(r"^(\S+)(\s+)(\S+)(\s+)(\S+)(\s+)(\S+)(\s+)(\S+)(\s+)(.*)$")


def main() -> int:
    argv = sys.argv[1:]
    if any(arg == "--libxo" or arg.startswith("--libxo=") for arg in argv):
        os.execv("/usr/bin/w", ["/usr/bin/w", *argv])

    proc = subprocess.run(
        ["/usr/bin/w", *argv],
        capture_output=True,
        text=True,
    )

    if proc.returncode != 0:
        sys.stdout.write(proc.stdout)
        sys.stderr.write(proc.stderr)
        return proc.returncode

    self_pid = os.getpid()
    for line in proc.stdout.splitlines():
        sys.stdout.write(rewrite_line(line, self_pid) + "\n")

    if proc.stderr:
        sys.stderr.write(proc.stderr)

    return 0


def rewrite_line(line: str, self_pid: int) -> str:
    match = ROW_RE.match(line)
    if not match:
        return line

    tty = match.group(3)
    if tty in {"TTY", "up"}:
        return line

    what = foreground_command_for_tty(tty, self_pid)
    if what is None:
        return line

    return "".join(match.groups()[:10]) + what


@lru_cache(maxsize=None)
def foreground_command_for_tty(tty: str, self_pid: int) -> Optional[str]:
    if tty == "console":
        return None

    candidates = [tty]
    if not tty.startswith("tty"):
        candidates.append(f"tty{tty}")

    for candidate in candidates:
        proc = subprocess.run(
            [
                "ps",
                "-t",
                candidate,
                "-o",
                "pid=",
                "-o",
                "ppid=",
                "-o",
                "pgid=",
                "-o",
                "stat=",
                "-o",
                "args=",
            ],
            capture_output=True,
            text=True,
        )
        if proc.returncode != 0:
            continue

        rows = []
        for raw in proc.stdout.splitlines():
            parts = raw.strip().split(None, 4)
            if len(parts) != 5:
                continue

            try:
                pid = int(parts[0])
                ppid = int(parts[1])
                pgid = int(parts[2])
            except ValueError:
                continue

            if pid == self_pid or ppid == self_pid:
                continue

            rows.append((pid, pgid, "+" in parts[3], parts[4].strip()))

        if not rows:
            continue

        foreground = [row for row in rows if row[0] == row[1] and row[2]]
        if not foreground:
            foreground = [row for row in rows if row[2]]

        chosen = max(foreground or rows, key=lambda row: row[0])
        if chosen[3]:
            return chosen[3]

    return None


if __name__ == "__main__":
    raise SystemExit(main())
