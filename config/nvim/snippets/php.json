{
  "getter function …": {
    "prefix": "getter",
    "body": [
      "/**",
      " * @return ${3:type}",
      " */",
      "public function get${1:propertyName}(): ${3:type}",
      "{",
      "\treturn \\$this->${2:variable};",
      "}"
    ],
    "description": "Getter function"
  },

  "setter function …": {
    "prefix": "setter",
    "body": [
      "/**",
      " * @param ${2:type} \\$${3:variable}",
      " * @return void",
      " */",
      "public function set${1:propertyName}(${2:type} \\$${3:variable}): void",
      "{",
      "\t\\$this->${4:column} = \\$${3:variable};",
      "}"
    ],
    "description": "Setter function"
  },

  "phpstan ignore-line": {
    "prefix": "phpstan-ignore-line",
    "body": [
      "/* @phpstan-ignore-line */"
    ],
    "description": "PHPStan ignore-line"
  },

  "phpstan ignore-next-line": {
    "prefix": "phpstan-ignore-next-line",
    "body": [
      "/* @phpstan-ignore-next-line */"
    ],
    "description": "PHPStan ignore-next-line"
  }
}
